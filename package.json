{
  "name": "gipe-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hml": "dotenv -e .env.hml -- next build",
    "build:azl": "dotenv -e .env.azl -- next build",
    "build:prod": "dotenv -e .env.prod -- next build",
    "start": "next start",
    "start:hml": "dotenv -e .env.hml -- next start",
    "start:azl": "dotenv -e .env.azl -- next start",
    "start:prod": "dotenv -e .env.prod -- next start",
    "lint": "eslint",
    "test": "vitest run",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "generate:icons": "node scripts/gerar-icones.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "next": "^16.4.3",
    "onnxruntime-web": "1.22.0",
    "qrcode": "1.5.4",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-styled-components": "^2.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "30.1.3",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
